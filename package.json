{
  "name": "kommandekollen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=18.20.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:worker": "esbuild worker/index.ts --bundle --format=esm --platform=browser --outfile=.worker/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:worker && vitest run",
    "test:browser": "playwright test",
    "api:dev": "wrangler dev --local",
    "db:local": "wrangler d1 migrations apply kommandekollen --local",
    "db:migrate": "tsx scripts/migrate.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260918.1",
    "@playwright/test": "1.55.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.0",
    "miniflare": "^4.0.0",
    "node": "22.23.2",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "wrangler": "4.135.0"
  }
}
